# Allow-script approvals live in package.json ("allowScripts" field).
# Do NOT set allow-scripts here — any .npmrc value is exported into the
# child git-dep install env and breaks them with EALLOWSCRIPTS.

# vitest 5.1.0 declares a peerOptional @types/node ^22 that conflicts with the
# root @types/node ^20; peerOptional is advisory, so let npm skip the check.
legacy-peer-deps=true
